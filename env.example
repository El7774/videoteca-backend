# Copia questo file in ".env" (senza ".example") e riempi i valori veri.
# Il file ".env" NON va mai caricato su GitHub: contiene segreti.

# Stringa di connessione al database, la trovi nella dashboard di Neon (o Render Postgres)
DATABASE_URL=postgresql://utente:password@host/nomedatabase?sslmode=require

# Una stringa lunga e casuale, usala solo tu per firmare i token di accesso.
# Puoi generarne una qui: https://www.uuidgenerator.net/ (o simili)
JWT_SECRET=cambia-questa-stringa-con-qualcosa-di-lungo-e-casuale

# Indirizzo/i del tuo sito GitHub Pages, separati da virgola se più di uno.
# Esempio: https://tuonomeutente.github.io
ALLOWED_ORIGINS=https://tuonomeutente.github.io

PORT=3000
